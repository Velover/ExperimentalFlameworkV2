{
  "name": "flamework",
  "private": true,
  "workspaces": [
    "./packages/*",
    "./packages/transformer/tests/fixture"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.mjs",
    "build:transformer": "bun run ./scripts/build.mjs transformer-plugin transformer",
    "lint": "eslint .",
    "test": "bun run ./scripts/test.mjs",
    "test:unit": "bun test --timeout 120000 packages/transformer/tests",
    "test:packaging": "bun test tests/packaging",
    "test:runtime": "bun run ./scripts/test-runtime.mjs",
    "dev:link": "node ./scripts/link-all.mjs",
    "prepare:readme": "node ./scripts/copy-readme.mjs",
    "prepare:publish": "bun run prepare:readme && bun run build"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.9.1",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-roblox-ts": "^0.0.36",
    "prettier": "^3.3.3",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.2.0"
  },
  "dependencies": {
    "rbxts-transformer-flamework": "workspace:*"
  }
}
