{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"outDir": "out",
		"rootDir": "src",
		"typeRoots": ["node_modules/@types"],
		"declaration": true,

		"strict": true,
		"lib": ["ES2020"],

		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"]
}
