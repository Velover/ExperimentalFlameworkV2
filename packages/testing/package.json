{
  "name": "@flamework-experimental/testing",
  "version": "2.0.0-alpha.0",
  "description": "In-place tests for Flamework games: define sections of tests, run them through a BindableFunction in Workspace, from the client through a RemoteFunction, or from an Open Cloud task.",
