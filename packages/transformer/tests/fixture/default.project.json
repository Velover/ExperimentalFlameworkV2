{
	"name": "fixture",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
	"tree": {
		"$className": "Folder",
		"out": { "$path": "out" },
		"include": { "$path": "include" },
		"node_modules": {
			"$className": "Folder",
			"@rbxts": { "$path": "node_modules/@rbxts" },
			"@flamework-experimental": { "$path": "node_modules/@flamework-experimental" }
		}
	}
}
