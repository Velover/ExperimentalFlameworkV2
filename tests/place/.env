FLAMEWORK_SCOPES=testing
# A copy of the original place the build is laid over before publishing; scripts/fabricate-original.luau makes this one.
ORIGINAL_PLACE=original.rbxl
# The Rojo projects `bun run test` runs the suite under, one run of both realms each: the default place, then
# the ones under tests/ that differ in Workspace's $properties (SignalBehavior, streaming). `--project <file>`
# on the command line runs one instead: bun run test --project tests/deferred.project.json
ROJO_PROJECT=default.project.json,tests/immediate.project.json,tests/deferred.project.json,tests/streaming.project.json
