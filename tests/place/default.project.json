{
	"name": "flamework-game",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@flamework-experimental": {
						"$className": "Folder",
						"core": {
							"$className": "Folder",
							"out": {
								"$path": "node_modules/@flamework-experimental/core/out"
							}
						},
						"components": {
							"$className": "Folder",
							"out": {
								"$path": "node_modules/@flamework-experimental/components/out"
							}
						},
						"networking": {
							"$className": "Folder",
							"out": {
								"$path": "node_modules/@flamework-experimental/networking/out"
							}
						},
						"testing": {
							"$className": "Folder",
							"out": {
								"$path": "node_modules/@flamework-experimental/testing/out"
							}
						}
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true
			},
			"Baseplate": {
				"$className": "Part",
				"$properties": {
					"Anchored": true,
					"Locked": true,
					"Size": [
						512,
						16,
						512
					],
					"Position": [
						0,
						-8,
						0
					],
					"Color": [
						0.388,
						0.372,
						0.384
					],
					"Material": "Concrete",
					"TopSurface": "Smooth",
					"BottomSurface": "Smooth"
				}
			},
			"SpawnLocation": {
				"$className": "SpawnLocation",
				"$properties": {
					"Anchored": true,
					"Size": [
						12,
						1,
						12
					],
					"Position": [
						0,
						0.5,
						0
					],
					"TopSurface": "Smooth",
					"BottomSurface": "Smooth"
				}
			}
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
